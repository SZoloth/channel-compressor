# ChatGPT subscriptions and OpenAI API billing are separate.
# The pipeline works without this key in --analysis-mode local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: save/fetch/sync through Readwise Reader.
READWISE_TOKEN=

# Optional if YouTube asks for authentication. Examples: chrome, safari, firefox.
YTDLP_COOKIES_BROWSER=
